<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2010/07/nuspec.xsd">
  <metadata>
    <id>FluentUI.SystemIcons.Assets</id>
    <version>1.1.323</version>
    <title>Fluent UI System Icons Assets</title>
    <authors>Microsoft</authors>
    <owners>Microsoft</owners>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <license type="expression">MIT</license>
    <projectUrl>https://github.com/microsoft/fluentui-system-icons</projectUrl>
    <repository type="git" url="https://github.com/microsoft/fluentui-system-icons.git" />
    <description>Content-only NuGet package that contains the Fluent UI System Icons assets folder.</description>
    <tags>fluentui icons assets content</tags>
    <readme>README.md</readme>
    <icon>logo.png</icon>
  </metadata>
  <files>
    <file src="logo.png" target="" />
    <file src="..\README.md" target="" />
    <file src="..\assets\**\*" target="assets" />
  </files>
</package>